# This directory holds the Firebase service-account key and API keys the
# mocktest PHP endpoints need at runtime — written here by the deploy
# workflow (not committed; see .github/workflows/deploy.yml). Nothing in
# it is meant to ever be served directly.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
